# Copy to .env at the repo root (and apps read via dotenv). NEVER commit real secrets.

# ---- Core ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ---- Database (Postgres) ----
DATABASE_URL=postgresql://shopstop:shopstop@localhost:5432/shopstop?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT ----
# In prod these come from a secrets manager and are rotated. 32+ byte random values.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-000000000000000
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=2592000     # seconds (30d)
# App-level envelope encryption key for secrets at rest (mfaSecret, etc.). 32 bytes hex.
ENCRYPTION_KEY=00000000000000000000000000000000

# ---- Email (SMTP; MailHog locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopStop <no-reply@shopstop.local>"

# ---- Object storage (MinIO locally / S3 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shopstop-media
S3_ACCESS_KEY=shopstop
S3_SECRET_KEY=shopstop-secret
S3_FORCE_PATH_STYLE=true      # true for MinIO; false for AWS S3
CDN_BASE_URL=http://localhost:9000/shopstop-media

# ---- Payments (Razorpay test mode) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# ---- OAuth (Google) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120

# ---- OTP (dev: logged; prod: SMS provider) ----
OTP_TTL_SEC=300
OTP_DEV_LOG=true

# ---- Monetization ----
# Platform commission in basis points (200 = 2%). Charged to the seller.
PLATFORM_FEE_BPS=200
# Sponsored-placement price per day, minor units (4900 = INR 49.00/day).
BOOST_PRICE_PER_DAY_MINOR=4900
# Card MDR in bps, used to estimate gateway cost when reporting net commission.
# Planning default — replace with your contracted rate. UPI is treated as zero-MDR.
MDR_CARD_BPS=200
