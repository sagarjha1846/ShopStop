# Environment for docker-compose.deploy.yml — running the published images.
#
#   cp .env.deploy.example .env.deploy    # then fill in the MUST SET values
#   docker compose -f docker-compose.deploy.yml --env-file .env.deploy up -d
#
# This is NOT .env.example. That file configures a developer's laptop, where
# everything runs on localhost and the placeholder secrets are deliberately
# worthless. Copying it into a deployment gives you an API that cannot reach its
# own database (inside a container `localhost` is the container) and secrets at
# rest encrypted with a published key.
#
# Hosts here are compose service names, which is what containers resolve.

# ---- Which images to run ----------------------------------------------------
# MUST SET. Your GitHub owner, lowercase — GHCR rejects uppercase image names.
IMAGE_OWNER=your-github-owner
# `latest` exists only once something reaches the default branch; on a feature
# branch use the branch name or sha-<full-commit>. List what is published:
#   TOKEN=$(curl -s "https://ghcr.io/token?scope=repository:$IMAGE_OWNER/shopstop/api:pull&service=ghcr.io" | jq -r .token)
#   curl -s -H "Authorization: Bearer $TOKEN" https://ghcr.io/v2/$IMAGE_OWNER/shopstop/api/tags/list | jq .tags
IMAGE_TAG=main

# ---- Data stores ------------------------------------------------------------
# MUST SET. docker-compose.deploy.yml ships no database on purpose: point this at
# a managed Postgres. The API runs `prisma migrate deploy` on every boot.
DATABASE_URL=postgresql://USER:PASSWORD@your-postgres-host:5432/shopstop?schema=public
# Redis runs in the compose file, so this is the service name, not localhost.
REDIS_URL=redis://redis:6379

# ---- Secrets ----------------------------------------------------------------
# MUST SET, all three. Generate, do not invent:
#   openssl rand -hex 32
# JWT secrets need 16+ characters; ENCRYPTION_KEY must be 32+ hex characters and
# encrypts secrets at rest (TOTP seeds). Changing it later makes those unreadable.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# ---- Public origin ----------------------------------------------------------
# MUST SET. The domain Caddy serves and the app builds links with. Set the same
# host in ops/Caddyfile, which is where TLS is terminated.
WEB_BASE_URL=https://shopstop.example

# ---- Payments ---------------------------------------------------------------
# Leave the placeholders to keep the gateway in dev mode: no live call is made
# and checkout uses synthetic ids. Real keys switch it to the live API, so set
# all three together or none.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# ---- Object storage ---------------------------------------------------------
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=shopstop-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
CDN_BASE_URL=https://cdn.shopstop.example

# ---- Email ------------------------------------------------------------------
# Transactional mail. The worker retries with backoff and surfaces failures, so
# a wrong host here shows up in the logs rather than silently dropping mail.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopStop <no-reply@shopstop.example>"

# ---- Money ------------------------------------------------------------------
# Commission in basis points (200 = 2.00%), snapshotted per order, so changing it
# never re-prices history. MDR_CARD_BPS is only used to estimate gateway cost when
# reporting net commission — replace it with your contracted card rate.
PLATFORM_FEE_BPS=200
BOOST_PRICE_PER_DAY_MINOR=4900
MDR_CARD_BPS=200
